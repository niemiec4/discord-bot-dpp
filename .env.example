# ── Discord bot configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.

# REQUIRED — your bot token from https://discord.com/developers/applications
# Enable these Privileged Gateway Intents for your bot in the developer portal:
#   • Presence Intent
#   • Server Members Intent
#   • Message Content Intent
BOT_TOKEN=

# OPTIONAL — register commands instantly in one server only.
# Great for development. Leave empty to register commands globally
# (globally registered commands can take up to an hour to appear).
GUILD_ID=

# OPTIONAL — your Discord user ID. When set, only you can use /sync
# (re-register slash commands). When empty, /sync requires Manage Server.
BOT_OWNER_ID=

# OPTIONAL — default channel ID for moderation logs (kick/ban/timeout/purge/warn).
# Note: every server can override this per-server with `/settings logchannel`.
# Leave empty to disable logs unless a server sets its own channel.
LOG_CHANNEL_ID=

# OPTIONAL — default channel ID for welcome messages when someone joins.
# Note: every server can override this per-server with `/settings welcome`.
# Leave empty to disable welcome messages unless a server sets its own channel.
WELCOME_CHANNEL_ID=

# NOTE: all persistent data (warnings, settings, levels, economy, custom
# commands, role menus, tickets, giveaways, polls) is stored in a single
# SQLite database at data/bot.db — no further configuration needed.

# ── Discord bot configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.

# REQUIRED — your bot token from https://discord.com/developers/applications
# Enable these Privileged Gateway Intents for your bot in the developer portal:
#   • Presence Intent
#   • Server Members Intent
#   • Message Content Intent
BOT_TOKEN=

# OPTIONAL — register commands instantly in one server only.
# Great for development. Leave empty to register commands globally
# (globally registered commands can take up to an hour to appear).
GUILD_ID=

# OPTIONAL — channel ID where moderation actions get logged (kick/ban/timeout/purge/warn).
# Leave empty to disable moderation logs.
LOG_CHANNEL_ID=

# OPTIONAL — channel ID where a welcome message is posted when someone joins.
# Leave empty to disable the welcome message.
WELCOME_CHANNEL_ID=
